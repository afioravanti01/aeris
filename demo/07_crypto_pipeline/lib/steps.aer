use io, fs, http, shell, env, clock, random, strings, date, json, yaml, net, ai, kube, docker, mongodb, minio, rabbitmq, audit

// Pipeline step functions for the crypto pipeline. Each function maps
// to exactly one step; the orchestrator in `main.aer` chains them with
// `?` and `catch` instead of the v0.1 `pipeline {}` block.

use crypto from "./crypto.aer"

pub fn normalize_input(input) {
  io.println("[normalize] processing input ({input.len()} chars)")

  var content = input.trim().lower()

  // Strip ASCII control characters (0x00-0x1F except \n, \t) via tr.
  let clean = shell.exec([
    "sh", "-c",
    "printf '%s' '{content}' | tr -d '\\000-\\010\\013\\014\\016-\\037' 2>/dev/null",
  ]) catch err { { argv0: "", exit: 1, stdout: content, stderr: "" } }
  if clean.exit == 0 { content = clean.stdout }

  // Canonical JSON: re-serialise with sorted keys when the input parses.
  let parsed = json.parse(content) catch err { None }
  if parsed != None {
    let v = parsed ?? content
    content = json.stringify(v)
    io.println("[normalize] JSON input detected — keys sorted for canonical form")
  }

  let byte_length = content.len()
  io.println("[normalize] normalized to {byte_length} bytes")
  return {
    content:       content,
    byte_length:   byte_length,
    normalized_at: date.now(),
  }
}

pub fn hash(normalized) {
  io.println("[hash] computing SHA-256 of {normalized.byte_length} bytes")
  let digest = crypto.sha256_hex(normalized.content)
  io.println("[hash] sha256={digest.slice(0, 16)}...")
  return { original: normalized, sha256: digest }
}

pub fn sign(hashed) {
  io.println("[sign] signing hash with HMAC-SHA256")
  let key       = env.must_read("AERIS_HMAC_KEY")
  let hmac      = crypto.hmac_sha256_hex(key, hashed.sha256)
  let signed_at = date.now()
  io.println("[sign] signed at {signed_at} (hmac={hmac.slice(0, 16)}...)")
  return { hashed: hashed, hmac: hmac, signed_at: signed_at }
}

pub fn verify(signed) {
  io.println("[verify] verifying HMAC signature")
  let key        = env.must_read("AERIS_HMAC_KEY")
  let expected   = signed.hmac
  let recomputed = crypto.hmac_sha256_hex(key, signed.hashed.sha256)
  let verified_at = date.now()

  if recomputed != expected {
    io.println("[verify] HMAC mismatch — payload may have been tampered with")
    return { ok: false, exit_code: 1, verified_at: verified_at }
  }

  io.println("[verify] signature verified at {verified_at}")
  return { ok: true, signed: signed, verified: true, verified_at: verified_at, exit_code: 0 }
}

pub fn encode(verified) {
  io.println("[encode] base64-encoding payload")
  let payload_json = json.stringify(verified)
  let encoded      = crypto.base64_encode(payload_json)
  return {
    encoded:          encoded,
    algorithm:        "SHA256+HMAC-SHA256+BASE64",
    envelope_version: "1.0",
  }
}

pub fn emit(sealed, output_mode, output_path) {
  io.println("[emit] emitting sealed payload (mode={output_mode})")
  let payload     = json.pretty(sealed)
  let byte_length = payload.len()
  let dest        = output_path ?? "/tmp/sealed.json"

  if output_mode == "file" {
    fs.write_text(dest, payload)
    io.println("[emit] written {byte_length} bytes to {dest}")
    return { destination: dest, byte_length: byte_length, success: true }
  }
  io.println("[emit] stdout output:")
  io.println(payload)
  return { destination: "stdout", byte_length: byte_length, success: true }
}
