/// Sample project materialisation — three small Python files,
/// one deliberate issue per dimension. Written to disk so the
/// demo is fully self-contained.

use "./models.aer"
use fs

const SAMPLE_APP_PY = """
import sqlite3

def find_user(conn, username):
    # Naive query builder — input is concatenated directly.
    q = "SELECT * FROM users WHERE name = '" + username + "'"
    return conn.execute(q).fetchone()

def main():
    conn = sqlite3.connect("app.db")
    print(find_user(conn, input("user> ")))
"""

const SAMPLE_UTILS_PY = """
def deduplicate(items):
    out = []
    for x in items:
        if x not in out:
            out.append(x)
    return out
"""

const SAMPLE_CONFIG_PY = """
import os
import sys

list = ["a", "b", "c"]

API_TIMEOUT = 30
"""

/// Write three files to `out_dir` and return the corresponding
/// `Codebase@v1`. `intent` documents the *why* into the trace —
/// optional under `enforce = "off"`, idiomatic in any mode.
pub fn materialise_sample_project(out_dir: string) -> Codebase@v1 {
  intent "materialise sample project for review" {
    fs.mkdir(out_dir)
    fs.write_text("{out_dir}/app.py",    SAMPLE_APP_PY)
    fs.write_text("{out_dir}/utils.py",  SAMPLE_UTILS_PY)
    fs.write_text("{out_dir}/config.py", SAMPLE_CONFIG_PY)
  }

  Codebase@v1 {
    name: "demo-app",
    files: [
      SourceFile@v1 { path: "app.py",    content: SAMPLE_APP_PY    },
      SourceFile@v1 { path: "utils.py",  content: SAMPLE_UTILS_PY  },
      SourceFile@v1 { path: "config.py", content: SAMPLE_CONFIG_PY },
    ],
  }
}
