/// Demo 11 — Chatbot REPL su markdown locale, backend Claude headless.
///
/// `ai.chat(system, dir)` carica tutta la cartella `docs/` come
/// knowledge base in startup. `chat.ask(prompt)` invia la domanda
/// passando per il backend configurato in `aeris.toml [ai.backend]`.
///
/// Nessuna `cap`, nessuna `intent`, nessun `load_corpus` a mano —
/// `enforce = "off"` lascia il codice come uno script v0.1.

let PROMPT: string = "you> "

fn main() {
  let chat = ai.chat(
    system: "Sei un assistente conciso. Rispondi SOLO usando la knowledge "
    + "base tra i marker FILE qui sotto. Se la risposta non c'è, "
    + "di' 'non lo so'. Rispondi in italiano.",
    dir: "./docs",
  )

  io.println("Aeris chatbot avviato su ./docs ({chat.kb_size()} file caricati).")
  io.println("Digita una domanda, riga vuota o 'quit' per uscire.\n")

  loop {
    io.print("{PROMPT}")
    let q = io.read_line() ?? ""
    if q == "" { break }
    if q == "quit" { break }
    let reply = chat.ask(q)
    io.println("bot> " + reply + "\n")
  }

  io.println("ciao.")
}
