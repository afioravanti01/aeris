/// Gateway integration tests. Requires the upstream services and the
/// gateway to be running (`aeris run upstreams.aer` + `aeris run
/// main.aer`). Runs every test against the live gateway on port 8080.

use io, fs, http, shell, env, clock, random, strings, date, json, yaml, net, ai, kube, docker, mongodb, minio, rabbitmq, audit

let BASE = "http://localhost:8080"

test "health check returns ok status" {
  let resp = http.get("{BASE}/health")
  assert_status(resp, 200)
  let body = json.parse(resp.body)
  assert body.status == "ok"
  assert_semantic(resp.body, "JSON response with status ok and rate_limit info")
}

test "unknown route returns 404" {
  let resp = http.get("{BASE}/api/unknown")
  assert_status(resp, 404)
  assert_semantic(resp.body, "error message saying no route matched")
}

test "list users returns seeded users" {
  let resp = http.get("{BASE}/api/users")
  assert_status(resp, 200)
  let users = json.parse(resp.body)
  assert users.len() >= 3
  assert_semantic(resp.body, "JSON array of user objects with id, name, email and role fields")
}

test "get existing user by id" {
  let resp = http.get("{BASE}/api/users/u1")
  assert_status(resp, 200)
  let user = json.parse(resp.body)
  assert user.id == "u1"
  assert_semantic(resp.body, "user object for Alice with admin role and an email address")
}

test "get non-existent user returns 404" {
  let resp = http.get("{BASE}/api/users/u999")
  assert_status(resp, 404)
  assert_semantic(resp.body, "error message saying the user was not found")
}

test "create user returns 201" {
  let payload = json.stringify({ name: "Diana", email: "diana@example.com", role: "user" })
  let resp = http.post("{BASE}/api/users", payload)
  assert_status(resp, 201)
  let user = json.parse(resp.body)
  assert user.name == "Diana"
  assert_semantic(resp.body, "newly created user named Diana with an id and email diana@example.com")
}

test "list products returns seeded products" {
  let resp = http.get("{BASE}/api/products")
  assert_status(resp, 200)
  let products = json.parse(resp.body)
  assert products.len() >= 4
  assert_semantic(resp.body, "JSON array of product objects with id, name, price, stock and category")
}

test "create order returns pending status" {
  let payload = json.stringify({ user_id: "u1", product_id: "p1", quantity: 2 })
  let resp = http.post("{BASE}/api/orders", payload)
  assert_status(resp, 201)
  let order = json.parse(resp.body)
  assert order.status == "pending"
  assert_semantic(resp.body, "new order in pending status for user u1 with quantity 2 and a creation timestamp")
}
