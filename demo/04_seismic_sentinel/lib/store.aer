// MinIO-backed persistence of the dashboard payload. The runtime
// stub (`minio.*` in v0.3) keeps every op trace-recorded and policy-
// gated; the real backend talks to a MinIO instance when configured.

pub let BUCKET = "seismic-sentinel"

pub fn setup() {
  let exists = minio.bucket_exists(BUCKET) catch err { false }
  if not exists {
    minio.mb(BUCKET) catch err {
      io.println("[minio] warning creating bucket: {err}")
    }
    io.println("[minio] created bucket: {BUCKET}")
  }
}

pub fn save_data(json_data) {
  setup()
  minio.put(
    bucket:  BUCKET,
    object:  "data.json",
    content: json_data,
  ) catch err {
    io.println("[minio] error uploading data.json: {err}")
  }
  io.println("[minio] uploaded: data.json")
}

pub fn load_data() {
  let r = minio.get(bucket: BUCKET, object: "data.json") catch err { None }
  return r
}
