use net_lib  from "./network.aer"
use docs_lib from "./docs.aer"
use chat_lib from "./chat.aer"

pub fn build_network(agents_dir, docs_dir, project_path) {
  return net_lib.build_network(agents_dir, docs_dir, project_path)
}

pub fn save_docs(trace, docs_dir) {
  return docs_lib.save_docs(trace, docs_dir)
}

pub fn start_chat_server(agents_dir, docs_dir, port) {
  return chat_lib.start_chat_server(agents_dir, docs_dir, port)
}
