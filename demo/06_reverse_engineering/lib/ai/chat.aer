use io, fs, http, shell, env, clock, random, strings, date, json, yaml, net, ai, kube, docker, mongodb, minio, rabbitmq, audit

// AI chat server. v0.1 used the convenience `ai.chat(...).start(port:)`
// which is not part of v0.3. We compose it ourselves with `net.http`
// and a single endpoint that proxies POST bodies to `chat.ask`.

pub fn start_chat_server(agents_dir, docs_dir, port) {
  let chat   = ai.chat(system: fs.read_text("{agents_dir}/assistant.md"), dir: docs_dir)
  let server = net.http(port: port)
  io.println("[chat] listening on http://localhost:{port}")

  loop {
    let req = server.accept()
    spawn {
      if req.path == "/chat" and req.method == "POST" {
        let prompt = req.body ?? ""
        let reply  = chat.ask(prompt: prompt) catch err {
          req.reply_json(status: 500, body: json.stringify({ error: "chat failed" }))
          return
        }
        req.reply_json(status: 200, body: json.stringify({ response: reply }))
      } else if req.method == "OPTIONS" {
        req.reply(status: 204, body: "")
      } else {
        req.reply(status: 404, body: "not found")
      }
    }
  }
}
