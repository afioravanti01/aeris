pub fn agent_output_file(agent_name) {
  if agent_name == "analyzer"     { return "analysis.md" }
  if agent_name == "requirements" { return "requirements.md" }
  if agent_name == "architecture" { return "architecture.md" }
  if agent_name == "improvements" { return "improvements.md" }
  return None
}

pub fn save_docs(trace, docs_dir) {
  for entry in trace {
    let output_file = agent_output_file(entry.from)
    if output_file != None {
      let name = output_file ?? ""
      fs.write_text("{docs_dir}/{name}", entry.response)
      io.println("  [{entry.from}] Saved: {name}")
    }
  }
}
