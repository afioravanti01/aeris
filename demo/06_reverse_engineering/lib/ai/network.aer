use io, fs, http, shell, env, clock, random, strings, date, json, yaml, net, ai, kube, docker, mongodb, minio, rabbitmq, audit

// Output files per agent. The orchestrator is coordination-only — it
// produces no document — so it is not in this list.
pub let DOC_OUTPUTS = ["analysis.md", "requirements.md", "architecture.md", "improvements.md"]

pub fn is_complete(docs_dir) {
  for output in DOC_OUTPUTS {
    if not fs.exists("{docs_dir}/{output}") { return false }
  }
  return true
}

// Builds and runs the agent network. Skips when every output file is
// already present.
pub fn build_network(agents_dir, docs_dir, project_path) {
  if is_complete(docs_dir) {
    io.println("All documents already exist, skipping analysis.")
    return { rounds: 0, trace: [] }
  }

  var net = ai.network(max_rounds: 25)

  net.agent(name: "orchestrator", system: fs.read_text("{agents_dir}/orchestrator.md"))
  net.agent(name: "analyzer",     system: fs.read_text("{agents_dir}/analyzer.md"))
  net.agent(name: "requirements", system: fs.read_text("{agents_dir}/requirements.md"))
  net.agent(name: "architecture", system: fs.read_text("{agents_dir}/architecture.md"))
  net.agent(name: "improvements", system: fs.read_text("{agents_dir}/improvements.md"))

  return net.run(
    entry:   "orchestrator",
    message: "Start the reverse engineering process for the project at: {project_path}",
    until:   "DONE",
  )
}
