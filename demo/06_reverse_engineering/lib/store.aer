pub let BUCKET = "reverse-engineering"

pub fn setup() {
  let exists = minio.bucket_exists(BUCKET) catch err { false }
  if not exists {
    minio.mb(BUCKET) catch err {
      io.println("[minio] warning creating bucket: {err}")
    }
    io.println("[minio] created bucket: {BUCKET}")
  }
}

pub fn upload_all(docs_dir) {
  setup()
  let files = ["analysis.md", "requirements.md", "architecture.md", "improvements.md"]
  for file in files {
    let path = "{docs_dir}/{file}"
    if fs.exists(path) {
      let content = fs.read_text(path)
      minio.put(bucket: BUCKET, object: file, content: content) catch err {
        io.println("[minio] error uploading {file}: {err}")
      }
      io.println("[minio] uploaded: {file}")
    }
  }
}

pub fn list_docs() {
  return minio.list(BUCKET) catch err { [] }
}

pub fn get_doc(name) {
  return minio.get(bucket: BUCKET, object: name) catch err { None }
}
