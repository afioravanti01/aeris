use io, fs, http, shell, env, clock, random, strings, date, json, yaml, net, ai, kube, docker, mongodb, minio, rabbitmq, audit

pub let BUCKET = "open-city"

pub fn setup() {
  let exists = minio.bucket_exists(BUCKET) catch err { false }
  if not exists {
    minio.mb(BUCKET) catch err {
      io.println("[minio] warning creating bucket: {err}")
    }
    io.println("[minio] created bucket: {BUCKET}")
  }
}

pub fn save_data(json_data) {
  setup()
  minio.put(bucket: BUCKET, object: "data.json", content: json_data) catch err {
    io.println("[minio] error uploading data.json: {err}")
  }
  io.println("[minio] uploaded: data.json")
}

pub fn load_data() {
  return minio.get(bucket: BUCKET, object: "data.json") catch err { None }
}
