/// Three assertion idioms over a public HTTP endpoint
/// (`http://httpbin.org`) plus a pure-text semantic check.
///
/// Run:
///   aeris test
///   aeris test ./tests/api.test.aer
///
/// Tests 1–3 hit a live HTTP endpoint; tests 3–4 also call the
/// configured `[ai.backend]` as a judge for `assert_semantic`.

use http, json

// ─── 1. status code probe ────────────────────────────────────────
//
// `retry { ... }` re-runs the block on failure — handy when the
// first connection to a public host gets bitten by DNS / TCP
// warm-up latency. Three attempts with linear backoff is a
// pragmatic default for CI.

test "httpbin.org/get returns 200" {
  let resp = retry 3, delay: 200ms {
    http.get("http://httpbin.org/get")
  }?
  assert_status(resp, 200)
}

// ─── 2. structural check on the JSON response ────────────────────
//
// `assert_json(resp, key, expected)` looks up `resp.<key>` (or
// `resp.json.<key>`) and asserts strict equality with `expected`.
// httpbin's `/get` echoes the inbound URL — perfect for an
// assertion that doesn't drift over time.

test "httpbin.org/get echoes the requested URL" {
  let resp = retry 3, delay: 200ms {
    http.get("http://httpbin.org/get?probe=aeris")
  }?
  let body = json.parse(resp.body)?
  assert_json(body, "url", "http://httpbin.org/get?probe=aeris")
}

// ─── 3. semantic check on a textual answer ───────────────────────
//
// `assert_semantic(actual, criterion)` asks the configured AI
// backend to judge whether `actual` satisfies `criterion`. The
// judge call is recorded in the JSONL trace and replays offline
// like any other `ai.*` call.

test "static description matches a semantic criterion" {
  let description = "Aeris is a small, typed scripting language that
                     pairs domain primitives (saga, agent, model, cap)
                     with a verifiable runtime."
  assert_semantic(
    description,
    "describes a programming language and mentions at least one of: typing, safety, verifiability",
  )
}

// ─── 4. semantic check over a live HTTP response ─────────────────
//
// `httpbin.org/uuid` returns a random UUID inside a JSON wrapper.
// We feed the raw body to the judge and let it confirm that the
// payload contains a UUID-shaped string. This is the pattern for
// asserting things you cannot literally compare for equality —
// human-readable descriptions, summaries, classifications.

test "httpbin.org/uuid returns a UUID-shaped payload" {
  let resp = retry 3, delay: 200ms {
    http.get("http://httpbin.org/uuid")
  }?
  assert_semantic(
    resp.body,
    "contains a UUID string in canonical 8-4-4-4-12 hexadecimal form",
  )
}
