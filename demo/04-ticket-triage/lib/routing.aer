/// AI categorisation + per-category forward. The cap surface is
/// split in two: `categorise` only needs `ai.complete`, `forward`
/// only needs `http.post` (allow-listed) + `audit.event`.

use io, http, ai, audit

const CATEGORIES = ["billing", "bug", "feature", "spam"]

const TRIAGE_PROMPT = """
You are a support-ticket triager. Given an inbound ticket (a
JSON payload with `subject`, `body`, `sender`), pick the single
best category. Reply with exactly one of:
billing, bug, feature, spam.

Use:
  - billing  for invoicing / pricing / refund / subscription topics
  - bug      for crash reports, unexpected behaviour, regressions
  - feature  for product requests, "would be nice if" ideas
  - spam     for obvious unsolicited content, ads, or auto-replies
"""

pub const UPSTREAM_PORT = 9090

/// Ask the LLM which category fits the inbound ticket.
/// `ai.decide` post-validates that the reply is one of `choices`;
/// up to `retries` (default 3) re-asks on mismatch.
pub fn categorise(
  payload: string,
  cap: cap[
    ai.complete @ ["claude-sonnet-4-6"],
    ai.decide   @ ["claude-sonnet-4-6"],
    io.println,
  ],
) -> result<string> {
  intent "categorise the inbound support ticket" {
    let full_prompt = "{TRIAGE_PROMPT}\n\nTicket:\n{payload}"
    io.println("[router]   ai.decide → calling claude-sonnet-4-6 (choices: billing|bug|feature|spam)")
    let category = ai.decide(prompt: full_prompt, choices: CATEGORIES, retries: 3)
    io.println("[router]   ai.decide ← {category}")
    Ok(category)
  }
}

pub fn backend_url(category: string) -> string {
  if category == "billing"      { "http://localhost:{UPSTREAM_PORT}/billing" }
  else if category == "bug"     { "http://localhost:{UPSTREAM_PORT}/bug" }
  else if category == "feature" { "http://localhost:{UPSTREAM_PORT}/feature" }
  else if category == "spam"    { "http://localhost:{UPSTREAM_PORT}/spam" }
  else                          { "" }
}

/// Forward the ticket to the category-specific backend. When the
/// upstream is up the call succeeds and the response is recorded;
/// if the sibling process isn't running, the `catch` degrades to
/// an `audit.event` so the decision still leaves a trail.
pub fn forward(
  category: string,
  payload: string,
  cap: cap[
    http.post @ ["localhost"],
    audit.event,
    io.println,
  ],
) -> result<int> {
  let url = backend_url(category)
  intent "forward ticket to the category backend" {
    io.println("[router]   http.post → {url}")
    let outcome = http.post(url, payload, "application/json") catch err {
      io.println("[router]   http.post failed: {err}")
      io.println("[router]   hint: start the upstream with `aeris run main.aer upstream`")
      audit.event("ticket.forward_failed", {
        category: category,
        url:      url,
        reason:   "upstream unreachable",
      })
      return Ok(0)
    }
    io.println("[router]   http.post ← status {outcome.status}")
    audit.event("ticket.forwarded", {
      category: category,
      url:      url,
      status:   outcome.status,
    })
    Ok(outcome.status)
  }
}
